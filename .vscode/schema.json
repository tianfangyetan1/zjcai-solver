{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "account": {
      "type": "object",
      "description": "网站 zjcai.com 的账号信息",
      "properties": {
        "username": {
          "type": "string",
          "description": "网站 zjcai.com 的用户名"
        },
        "password": {
          "type": "string",
          "description": "网站 zjcai.com 的密码"
        }
      },
      "required": [
        "username",
        "password"
      ]
    },
    "deepseek-api-key": {
      "type": "string",
      "description": "Deepseek 的 API-Key，是调用 API 的凭证\n切记不要泄露给他人！",
      "pattern": "^sk-.+"
    },
    "llm-model": {
      "type": "string",
      "description": "模型名称\n题目中的图片需要依赖图像理解能力，请选择支持图片理解的模型，例如 deepseek-flash",
      "default": "deepseek-flash"
    },
    "reasoning-effort": {
      "type": "string",
      "description": "思考强度\n越高回答质量越好，但速度更慢，消耗的 token 更多",
      "enum": [
        "low",
        "high",
        "max"
      ],
      "default": "high"
    },
    "chromedriver-path": {
      "type": "string",
      "description": "Chrome Driver 的路径",
      "format": "uri"
    }
  },
  "required": [
    "account",
    "deepseek-api-key"
  ]
}